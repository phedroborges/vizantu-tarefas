OPENAI_API_KEY=

# Supabase (Postgres + Storage) — veja supabase/schema.sql pras tabelas e as
# instruções do bucket de imagens.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Nome do bucket de Storage (público) pra imagens anexadas no chat da IA.
# Se não definir, o app usa "vizantu-tarefas-uploads" como padrão.
SUPABASE_STORAGE_BUCKET=

# Porta em que o servidor escuta (o Dockerfile já expõe 31111 por padrão).
PORT=31111
