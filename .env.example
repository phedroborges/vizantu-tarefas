OPENAI_API_KEY=

# Supabase (Postgres + Storage) — veja supabase/schema.sql pras tabelas e as
# instruções do bucket de imagens. São server-only (nunca chegam ao navegador).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Nome do bucket de Storage (público) pra imagens anexadas no chat da IA.
# Se não definir, o app usa "vizantu-tarefas-uploads" como padrão.
SUPABASE_STORAGE_BUCKET=

# Supabase Auth (login) — estas SIM são expostas ao navegador (prefixo
# NEXT_PUBLIC_), mas a publishable key é segura pra isso por design (equivalente
# à antiga "anon key"). Mesmo projeto/URL das variáveis acima.
#
# IMPORTANTE: variáveis NEXT_PUBLIC_ são gravadas no bundle JS durante o
# `next build`, não lidas em tempo de execução — então configurá-las só na
# aba "Environment Variables" do EasyPanel (ou de qualquer painel parecido)
# NÃO funciona, porque essa aba injeta no container já rodando, depois que o
# build da imagem Docker já terminou. Os valores reais de produção ficam em
# `.env.production` (committado, com os mesmos valores do bloco acima) —
# o Next.js lê esse arquivo automaticamente durante o build.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL pública onde o app roda — usada no link de "esqueci minha senha".
NEXT_PUBLIC_APP_URL=http://localhost:31111

# Porta em que o servidor escuta (o Dockerfile já expõe 31111 por padrão).
PORT=31111
