# Variáveis NEXT_PUBLIC_* precisam existir no momento do `next build` (ficam
# gravadas no bundle do navegador), não em tempo de execução — por isso não
# basta configurá-las na aba "Environment Variables" do EasyPanel, que só
# injeta no container já rodando. O Next.js lê este arquivo automaticamente
# durante o build, então commitamos ele. Seguro: publishable key e URL do
# Supabase são projetadas para serem públicas (equivalente à antiga anon key).
NEXT_PUBLIC_SUPABASE_URL=https://banco-vizantu.metricz.com.br
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzk0MjE1MDczLCJleHAiOjE5NTE4OTUwNzN9.X4krtTf3aNMS7RxQRaRl4haS4_nwcur_7-bm-C5CBDQ
NEXT_PUBLIC_APP_URL=https://tarefas.metricz.com.br
NEXT_PUBLIC_PLANOS_URL=https://planos.metricz.com.br
